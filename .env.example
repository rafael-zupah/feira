# Feira Cultural — modelo do arquivo de segredos.
#
# No VPS, copie este arquivo para .env e preencha:
#   cp .env.example .env && chmod 600 .env
#
# O .env está no .gitignore e NUNCA deve ser versionado.

# Chave do Gemini — a única credencial deste projeto.
# Pegue em https://aistudio.google.com → "Get API key".
#
# ATENÇÃO: a geração de imagem é PAGA (US$ 0,0336 por imagem em 1K) e exige
# cobrança ativa no projeto do Google. Não existe mais cota gratuita para
# geração de imagem. Uma chave sem billing responde 429 em todas as chamadas.
GEMINI_API_KEY=

# Onde este servidor escuta. O Nginx fala com ele por 127.0.0.1, então isto não
# fica exposto para fora — quem atende a internet é o Nginx.
PORT=8090
HOST=127.0.0.1
