{
  // PLANO B — não é o caminho normal.
  //
  // O deploy de verdade é no VPS, com PM2 e Nginx (veja o README). Este arquivo
  // continua aqui porque src/worker.js é escrito em Request/Response padrão e,
  // portanto, roda nos dois lugares sem nenhuma alteração. Se o VPS der
  // problema no dia do evento, `npm run deploy` põe o mesmo app no ar em minutos.
  //
  // Depois de publicar, configure a chave como segredo:
  //   npx wrangler secret put GEMINI_API_KEY
  //
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "feira-personagens",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // A Cloudflare serve tudo que está em public/ sozinha.
  // O Worker só é acionado nas rotas /api/*, que não existem como arquivo.
  "assets": {
    "directory": "./public"
  }
}
